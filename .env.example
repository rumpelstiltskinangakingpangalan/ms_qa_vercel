# Supabase connection (public values — the anon key is browser-safe).
# These are optional: the app falls back to the original project's values
# (see lib/supabaseClient.ts) when they are not set. Override them here to
# point the app at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
